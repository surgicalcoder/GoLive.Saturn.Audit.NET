<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Generate detailed Audit Logs for gRPC server calls.</Description>
        <Copyright>Copyright 2025</Copyright>
        <AssemblyTitle>GoLive.Saturn.Audit.Grpc.Server</AssemblyTitle>
        <Authors>Federico Colombo</Authors>
        <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
        <DefineConstants>$(DefineConstants)</DefineConstants>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AssemblyName>GoLive.SaturnAudit.Grpc.Server</AssemblyName>
        <PackageId>GoLive.SaturnAudit.Grpc.Server</PackageId>
        <PackageTags>Audit;Trail;Log;Grpc</PackageTags>
        <PackageProjectUrl>https://github.com/surgicalcoder/GoLive.Saturn.Audit.NET</PackageProjectUrl>
        <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
        <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
        <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/surgicalcoder/GoLive.Saturn.Audit.NET</RepositoryUrl>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Audit.NET\Audit.NET.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Grpc.Core.Api" Version="2.71.0"/>
    </ItemGroup>
</Project>
