<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Store Audit.NET Logs into an Azure Blob Storage</Description>
        <Copyright>Copyright 2021</Copyright>
        <AssemblyTitle>GoLive.Saturn.Audit.AzureStorageBlobs</AssemblyTitle>
        <Authors>Federico Colombo</Authors>
        <TargetFramework>net10.0</TargetFramework>
        <DefineConstants>$(DefineConstants)</DefineConstants>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AssemblyName>Golive.Saturn.Audit.NET.AzureStorageBlobs</AssemblyName>
        <PackageId>Golive.Saturn.Audit.NET.AzureStorageBlobs</PackageId>
        <PackageTags>Audit;Trail;Log;Azure;Blob;BlobStorage</PackageTags>
        <PackageProjectUrl>https://github.com/surgicalcoder/GoLive.Saturn.Audit.NET</PackageProjectUrl>
        <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
        <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
        <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/surgicalcoder/GoLive.Saturn.Audit.NET</RepositoryUrl>
        <RootNamespace>Audit.AzureStorageBlobs</RootNamespace>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Azure.Storage.Blobs" Version="12.19.1"/>
    </ItemGroup>
    <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
        <PackageReference Include="System.Text.Json" Version="9.0.4"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Audit.NET\Audit.NET.csproj"/>
    </ItemGroup>
</Project>
