<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Store Audit.NET Logs into an Azure Table Storage</Description>
        <Copyright>Copyright 2022</Copyright>
        <AssemblyTitle>GoLive.Saturn.Audit.AzureStorageTables</AssemblyTitle>
        <Authors>Federico Colombo</Authors>
        <TargetFramework>net10.0</TargetFramework>
        <DefineConstants>$(DefineConstants)</DefineConstants>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AssemblyName>Golive.Saturn.Audit.NET.AzureStorageTables</AssemblyName>
        <PackageId>Golive.Saturn.Audit.NET.AzureStorageTables</PackageId>
        <PackageTags>Audit;Trail;Log;Azure;Tables;TableStorage</PackageTags>
        <PackageProjectUrl>https://github.com/surgicalcoder/GoLive.Saturn.Audit.NET</PackageProjectUrl>
        <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
        <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
        <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/surgicalcoder/GoLive.Saturn.Audit.NET</RepositoryUrl>

        <RootNamespace>Audit.AzureStorageTables</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Azure.Data.Tables" Version="12.8.2"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Audit.NET\Audit.NET.csproj"/>
    </ItemGroup>
</Project>
